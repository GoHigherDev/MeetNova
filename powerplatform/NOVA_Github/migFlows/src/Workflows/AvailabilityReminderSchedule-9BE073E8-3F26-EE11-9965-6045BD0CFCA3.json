              "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"false\">\n  <entity name=\"contact\">\n    <attribute name=\"fullname\" />\n    <attribute name=\"contactid\" />\n    <attribute name=\"new_availableuntil\" />\n    <order attribute=\"fullname\" descending=\"false\" />\n    <filter type=\"and\">\n      <condition attribute=\"new_allowavailabilitynotifications\" operator=\"eq\" value=\"1\" />\n      <condition attribute=\"new_iscandidate\" operator=\"eq\" value=\"1\" />\n      <condition attribute=\"new_availableuntil\" operator=\"not-null\" />\n    </filter>\n  </entity>\n</fetch>"
