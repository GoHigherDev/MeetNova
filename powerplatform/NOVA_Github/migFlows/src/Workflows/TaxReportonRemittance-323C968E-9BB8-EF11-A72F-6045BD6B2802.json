                      "entityName": "new_remittancetaxreports",
                      "recordId": "@first(outputs('List_tax_report_rows_by_candidate')?['body/value'])['new_remittancetaxreportid']",
                      "item/new_totalpaid": "@variables('PayTotal')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {
              "Add_a_new_tax_row": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "entityName": "new_remittancetaxreports",
                    "item/new_name": "@outputs('Get_a_candidate_row_by_ID')?['body/fullname']",
                    "item/new_candidateid@odata.bind": "@outputs('Get_a_candidate_row_by_ID')?['body/@odata.id']",
                    "item/transactioncurrencyid@odata.bind": "/transactioncurrencies(@{outputs('Get_a_remittance_row_by_ID')?['body/_transactioncurrencyid_value']})",
                    "item/new_managingaccountid@odata.bind": "/accounts(@{outputs('Get_a_remittance_row_by_ID')?['body/_new_managingaccountid_value']})",
                    "item/new_placementid@odata.bind": "/new_assignments(@{outputs('Get_a_remittance_row_by_ID')?['body/_new_assignmentid_value']})",
                    "item/new_supplierid@odata.bind": "/accounts(@{outputs('Get_a_remittance_row_by_ID')?['body/_new_supplierid_value']})",
                    "item/new_taxperiodid@odata.bind": "/new_taxperiods(@{body('Run_a_Child_Flow_-_get_tax_period')?['taxperiodid']})",
                    "item/new_totalpaid": "@variables('PayTotal')"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  }
