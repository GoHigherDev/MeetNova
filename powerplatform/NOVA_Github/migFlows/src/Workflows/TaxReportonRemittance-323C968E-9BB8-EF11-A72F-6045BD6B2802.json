              "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"false\" aggregate=\"true\">\n  <entity name=\"new_timesheet\">\n    <attribute name=\"new_remittanceid\" groupby=\"true\" alias=\"remittanceid\"/>\n    <attribute name=\"new_candidateid\" groupby=\"true\" alias=\"candidateid\"/>\n    <attribute name=\"new_pay\" aggregate=\"sum\" alias=\"total_pay\"/>\n    <filter type=\"and\">\n      <condition attribute=\"new_remittanceid\" operator=\"eq\" uitype=\"new_remittance\" value=\"@{outputs('Get_a_remittance_row_by_ID')?['body/new_remittanceid']}\" />\n      <condition attribute=\"new_candidateid\" operator=\"eq\"  uitype=\"contact\" value=\"@{triggerBody()?['text_1']}\" />\n    </filter>\n  </entity>\n</fetch>\n"
