              "fetchXml": "<fetch version=\"1.0\" output-format=\"xml-platform\" mapping=\"logical\" distinct=\"false\">\n  <entity name=\"new_remittancetaxreport\">\n    <attribute name=\"new_remittancetaxreportid\" />\n    <attribute name=\"new_name\" />\n    <attribute name=\"createdon\" />\n    <attribute name=\"new_totalpaid\" />\n    <attribute name=\"new_taxperiodid\" />\n    <attribute name=\"transactioncurrencyid\" />\n    <order attribute=\"new_name\" descending=\"false\" />\n    <filter type=\"and\">\n      <condition attribute=\"new_candidateid\" operator=\"eq\" uitype=\"contact\" value=\"@{triggerBody()?['text_1']}\" />\n      <condition attribute=\"new_managingaccountid\" operator=\"eq\"  uitype=\"account\" value=\"@{outputs('Get_a_remittance_row_by_ID')?['body/_new_managingaccountid_value']}\" />\n      <condition attribute=\"new_taxperiodid\" operator=\"eq\"  uitype=\"new_taxperiod\" value=\"@{body('Run_a_Child_Flow_-_get_tax_period')?['taxperiodid']}\" />\n    </filter>\n  </entity>\n</fetch>",
              "$top": 1
