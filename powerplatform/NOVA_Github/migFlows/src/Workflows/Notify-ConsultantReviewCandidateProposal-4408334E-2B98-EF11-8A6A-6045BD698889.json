        }
      },
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_d7b6b"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Timesheets url (new_Timesheetsurl)": {
          "defaultValue": "https://quickshifts-dev.powerappsportals.com/",
          "type": "String",
          "metadata": {
            "schemaName": "new_Timesheetsurl"
          }
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "85d5f554-8bea-4551-a2e3-e514373b7c04"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "new_job",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "statuscode ",
              "subscriptionRequest/filterexpression": "statuscode eq 0"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_a_Consultant_row_by_ID": {
          "runAfter": {
            "Get_Client_Approver_row_by_ID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bbacd524-06c3-4432-9d96-33914ec5d83c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "contacts",
              "recordId": "@triggerBody()?['_new_consultantid_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Send_an_email_Consultant": {
          "runAfter": {
            "Get_a_Consultant_row_by_ID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "48c43c1a-1089-4583-bf9b-bd670435d196"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@outputs('Get_a_Consultant_row_by_ID')?['body/emailaddress1']",
              "emailMessage/Subject": " New Job Posted - Start Sourcing Candidates Now",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Hi @{body('Get_a_Consultant_row_by_ID')?['firstname']},</p><br><p class=\"editor-paragraph\">A new job has been posted by @{outputs('Get_Client_Approver_row_by_ID')?['body/firstname']}. This email is notifying you to begin sourcing candidates for the following Job role:</p><br><p class=\"editor-paragraph\">Job Details:</p><p class=\"editor-paragraph\">Job Title: </p><p class=\"editor-paragraph\">Job Role: </p><p class=\"editor-paragraph\">Start Date: </p><p class=\"editor-paragraph\">Total Vacanices: </p><br><p class=\"editor-paragraph\">Please access the link below to review the Job details, and start reaching out to suitable candidates who match the role requirements.</p><br><br><p class=\"editor-paragraph\">@{parameters('Timesheets url (new_Timesheetsurl)')}/jobedit/?id=@{triggerOutputs()?['body/new_jobid']}</p><p class=\"editor-paragraph\"><br><a href=\" @{parameters('Timesheets url (new_Timesheetsurl)')}/jobedit/?id=@{triggerOutputs()?['body/new_jobid']}\" class=\"editor-link\">Job</a></p><br><p class=\"editor-paragraph\">Thank you,</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Client_Approver_row_by_ID": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "010deff8-bcdf-4e89-9e32-bc6f66dd504c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "contacts",
              "recordId": "@triggerBody()?['_new_approverid_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}