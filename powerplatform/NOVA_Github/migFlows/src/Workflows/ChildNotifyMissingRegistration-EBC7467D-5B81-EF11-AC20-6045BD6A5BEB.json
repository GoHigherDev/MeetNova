          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365-1",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@triggerBody()?['text']",
              "emailMessage/Subject": "@triggerBody()?['text_6']",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Hi @{triggerBody()?['text_1']},</p><br><p class=\"editor-paragraph\">You have a timesheet open for submission on Quickshifts.</p><p class=\"editor-paragraph\">Please submit the timesheet at your nearest convenience.</p><br><p class=\"editor-paragraph\">Timesheet Details:</p><p class=\"editor-paragraph\">Client: @{triggerBody()?['text_2']}</p><p class=\"editor-paragraph\">Period Start: @{triggerBody()?['text_3']}</p><p class=\"editor-paragraph\">Period End: @{triggerBody()?['text_4']}<br></p><br><p class=\"editor-paragraph\">However, before accessing the timesheet. Please click the link below to complete your registration process:</p>\n<br>\n<a href = \"@{parameters('Quickshifts Portal (new_QuickshiftsPortal)')}/registration/?contactid=@{triggerBody()?['text_5']}\">Registration</a>\n<br><p class=\"editor-paragraph\">Once you have completed your registration process, please click the link below to access the timesheet:</p>\n<br>\n<a href= \"@{parameters('Quickshifts Portal (new_QuickshiftsPortal)')}/candidatetimesheetdetails/?timesheetid=@{triggerBody()?['text_7']}&contactid=@{triggerBody()?['text_5']}\">@{outputs('Get_a_timesheet_row_by_ID')?['body/new_name']}</a>\n<br>\nThank you, Timesheets System",
              "emailMessage/Importance": "Normal"
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
