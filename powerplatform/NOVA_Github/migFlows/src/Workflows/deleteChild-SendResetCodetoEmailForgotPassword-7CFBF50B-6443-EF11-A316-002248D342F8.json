              "metadata": {
                "operationMetadataId": "c9e90da8-1511-4a49-b532-37dde80e442f"
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "title": "success",
                      "x-ms-dynamically-added": true,
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": {
                  "success": "@false"
                }
              }
            }
          },
          "runAfter": {
            "Send_an_email_(V2)": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@variables('email')",
                  "email"
                ]
              }
            ]
          },
          "type": "If"
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Condition": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c9e90da8-1511-4a49-b532-37dde80e442f"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "success",
                  "x-ms-dynamically-added": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": {}
