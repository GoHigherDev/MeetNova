        "Initialize_RandomNumbers_variable": {
          "runAfter": {
            "Initialize_email_variable": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RandomNumbers",
                "type": "string"
              }
            ]
          }
        },
        "Apply_to_each_1": {
          "foreach": "@outputs('Compose_array_of_6_items')",
          "actions": {
            "Compose_1": {
              "type": "Compose",
              "inputs": "@rand(0,9)"
            },
            "Set_RandomNumbers_variable_": {
              "runAfter": {
                "Composearray": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "RandomNumbers",
                "value": "@{outputs('Composearray')}"
              }
            },
            "Composearray": {
              "runAfter": {
                "Compose_1": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@concat(variables('RandomNumbers'), string(outputs('Compose_1')))\n"
            }
          },
          "runAfter": {
            "Compose_array_of_6_items": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        },
        "Compose_array_of_6_items": {
          "runAfter": {
            "Apply_to_each": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@createArray(1, 2, 3, 4, 5, 6)"
        },
        "Initialize_contactid_variable": {
          "runAfter": {
            "Initialize_RandomNumbers_variable": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "contactid",
                "type": "string",
                "value": "guid"
              }
            ]
          }
        },
        "Initialize_full_name_variable": {
          "runAfter": {
            "Initialize_contactid_variable": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "fullname",
                "type": "string",
                "value": "fullname"
              }
            ]
          }
        },
        "Send_an_email_(V2)": {
          "runAfter": {
            "Update_a_row": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5194ecc0-7964-44a1-b5c0-f45d8c1a96f7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "@variables('email')",
              "emailMessage/Subject": "Reset Password Code",
              "emailMessage/Body": "<p>To access the web site browse to this link and enter in the code below<br><span>\n</span></p><p>@{parameters('Quickshifts Portal (new_QuickshiftsPortal)')}/resetpassword/?contactid=@{variables('contactid')}<span>\n\n</span>Access Code: <span>\n</span>@{variables('RandomNumbers')}</p>",
              "emailMessage/ReplyTo": "noreply@TimesheetsTeam.com",
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365-1"
            }
          }
        },
        "Update_a_row": {
          "runAfter": {
            "Apply_to_each_1": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "contacts",
              "recordId": "@variables('contactid')",
              "item/new_signinaccesscode": "@variables('RandomNumbers')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        }
      }
    },
