          "runAfter": {},
          "metadata": {
            "operationMetadataId": "3ccf5361-f961-4b67-96c3-29a987764f69"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "email",
                "type": "string",
                "value": "email"
              }
            ]
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows')?['body/value']",
          "actions": {
            "Set_email_adress_variable": {
              "metadata": {
                "operationMetadataId": "06639711-4426-4634-a84b-4467cfb0dff4"
              },
              "type": "SetVariable",
              "inputs": {
