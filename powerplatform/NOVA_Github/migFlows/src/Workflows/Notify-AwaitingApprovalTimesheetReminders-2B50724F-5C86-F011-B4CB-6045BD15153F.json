                          "emailMessage/Cc": "@body('Get_a_Client_row_by_ID')?['new_invoiceccemails']",
                          "emailMessage/Importance": "Normal"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2",
                          "connectionName": "shared_office365-1"
                        }
                      },
                      "metadata": {
                        "operationMetadataId": "c2e29e4c-0dfc-49c4-b0ba-17eb15dba94b"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Send_an_email_(V2)-approve_by_email_reminder": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "emailMessage/To": "@body('Get_Client_Approver_by_ID')?['emailaddress1']",
                            "emailMessage/Subject": "Timesheet Pending Approval Reminder - @{triggerBody()?['new_name']}",
                            "emailMessage/Body": "@variables('Message')",
                            "emailMessage/Cc": "@body('Get_a_Client_row_by_ID')?['new_invoiceccemails']",
                            "emailMessage/Importance": "Normal"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "operationId": "SendEmailV2",
                            "connectionName": "shared_office365-1"
