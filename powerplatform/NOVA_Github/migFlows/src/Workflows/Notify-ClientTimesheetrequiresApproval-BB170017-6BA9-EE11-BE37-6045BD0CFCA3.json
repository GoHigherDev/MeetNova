                        "emailMessage/To": "@{body('Get_Client_Approver_by_ID')?['emailaddress1']}, hala.hassouna96@gmail.com",
                        "emailMessage/Subject": "@{body('Get_Candidate_by_ID')?['fullname']} - Timesheet Pending Approval ",
                        "emailMessage/Body": "@variables('Message')",
                        "emailMessage/Cc": "@outputs('Get_Placement_by_ID')?['body/new_approveremails']",
                        "emailMessage/Importance": "Normal"
