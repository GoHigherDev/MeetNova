                  "emailMessage/Subject": " Client has approved Candidate proposal",
                  "emailMessage/Body": "<p>User Name: @{outputs('Get_a_Consultant_row_by_ID')?['body/adx_identity_username']}<br>\n<br>\nDear @{outputs('Get_a_Consultant_row_by_ID')?['body/firstname']},<br>\n<br>\nThe @{outputs('Get_a_Candidate_row_by_ID')?['body/firstname']} proposal stage status has been updated and approved by the client for the @{outputs('Get_a_Job_row_by_ID')?['body/new_name']} position and is ready to move to the next recruitment stage.</p>\n<p><br>\nDetails:<br>\nJob Role: @{outputs('Get_a_Job_Roles_row_by_ID_')?['body/new_name']}</p>\n<p>Stage Type: @{outputs('Get_a_stage_type_row_by_ID_')?['body/new_name']}</p>\n<p>Approval Reasons: @{triggerOutputs()?['body/new_comments']}<br>\n<br>\nTo review this approval and take any required action, please click the link below:<br>\n@{parameters('Timesheets url (new_Timesheetsurl)')}jobapplications/?id=@{triggerOutputs()?['body/_new_jobid_value']}<br>\n<br>\n<br>\nBest regards,<br>\nJob Vendor System</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
